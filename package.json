  "author": "Alex Mittell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amittell/openclaw-scheduler.git"
  },
  "bugs": {
    "url": "https://github.com/amittell/openclaw-scheduler/issues"
  },
  "homepage": "https://github.com/amittell/openclaw-scheduler#readme",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^11.0.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^5.9.2"
  }
}
